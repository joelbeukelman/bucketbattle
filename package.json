{
  "name": "bucketbattle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @bb/game dev",
    "build": "pnpm --filter @bb/game build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "validate:worlds": "tsx tools/validate-worlds.ts",
    "shots": "tsx tools/screenshot.ts",
    "prompts": "tsx tools/build-prompts.ts",
    "studio": "pnpm --filter @bb/studio dev",
    "studio:shots": "tsx tools/studio-shots.ts",
    "studio:publish": "tsx tools/publish-studio.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
